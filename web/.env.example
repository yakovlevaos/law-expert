# Base URL of the Django catalog API (the sibling ../genesis repository).
# Local runserver:    http://127.0.0.1:8000/api/v1   <- the reference backend
# Local docker stack: http://127.0.0.1:8099/api/v1
#
# The game library filters, searches and pages through the API. The currently
# deployed production API is older and ignores those query parameters, so
# pointing this at production leaves the filters doing nothing.
API_BASE_URL=http://127.0.0.1:8000/api/v1

# Yandex.Metrika counter id. Leave empty to disable the counter locally.
NEXT_PUBLIC_YANDEX_METRIKA_ID=96536967
