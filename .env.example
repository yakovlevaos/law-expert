# Read by docker-compose (variable substitution) for both the image build and
# the running container. Copy to `.env` to override the defaults below.
#
# API_BASE_URL is baked into the image at build time as well as passed at
# runtime — `images.remotePatterns` is fixed during the build, so the two must
# agree or next/image will reject the backend's covers.
API_BASE_URL=https://genesis-expert.ru/api/v1

# Yandex.Metrika counter id. Inlined into the client bundle at build time;
# leave empty to build an image with no counter.
NEXT_PUBLIC_YANDEX_METRIKA_ID=96536967
